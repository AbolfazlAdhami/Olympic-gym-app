generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Exercise {
  id     String @id @default(uuid())
  nameEn String
  slug   String @unique

  force      String?
  mechanic   String?
  equipment  String?
  category   String?
  difficulty String?

  primaryMuscles   ExerciseMuscle[]
  secondaryMuscles ExerciseSecondaryMuscle[]

  instructions ExerciseInstruction[]
  translations ExerciseTranslation[]
  aliases      ExerciseAlias[]
  images       ExerciseImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipment])
  @@index([category])
  @@index([difficulty])
}

model ExerciseMuscle {
  id         String @id @default(uuid())
  exerciseId String
  muscle     String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscle])
  @@index([muscle])
}

model ExerciseSecondaryMuscle {
  id         String @id @default(uuid())
  exerciseId String
  muscle     String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([muscle])
  @@unique([exerciseId, muscle])
}

model ExerciseInstruction {
  id         String @id @default(uuid())
  exerciseId String
  step       Int
  text       String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, step])
}

model ExerciseImage {
  id         String @id @default(uuid())
  exerciseId String
  url        String
  position   Int

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, position])
}

model ExerciseTranslation {
  id         String @id @default(uuid())
  exerciseId String
  language   String

  name        String
  description String?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, language])
}

model ExerciseAlias {
  id         String @id @default(uuid())
  exerciseId String
  language   String
  alias      String
  normalized String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([normalized])
}
